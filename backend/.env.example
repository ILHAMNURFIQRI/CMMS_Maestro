# MANDOR - Environment Variables
# Copy this file to .env and configure for your environment.

# MQTT Configuration
# Use a private, authenticated broker for deployed equipment. Never expose a
# machine-control topic through a shared public broker.
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_ESP_TOPIC=mesin/monitoring/data
MQTT_CONTROL_TOPIC=mesin/kontrol/perintah
MQTT_ESP_MACHINE_ID=M-16

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=maestro_cmms

# Authentication
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_NAME=Initial Manager
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Simulation Configuration
SIMULATION_INTERVAL=5
DEFAULT_RPM=500
MAX_RPM=600
MIN_RPM=100
HEALTH_SCORE_THRESHOLD=60
ANOMALY_THRESHOLD=80
