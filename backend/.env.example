# MANDOR - Environment Variables
# Copy this file to .env and configure for your environment.

# MQTT Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=mandor
MYSQL_USER=root
MYSQL_PASSWORD=

# Simulation Configuration
SIMULATION_INTERVAL=5
DEFAULT_RPM=500
MAX_RPM=600
MIN_RPM=100
HEALTH_SCORE_THRESHOLD=60
ANOMALY_THRESHOLD=80
